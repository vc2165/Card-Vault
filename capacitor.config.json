{
  "appId": "com.vinay.cardvault",
  "appName": "Card Vault",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
